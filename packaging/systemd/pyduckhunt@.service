[Unit]
Description=pyDuckHunt IRC game bot (%i)
Documentation=file:/home/mediabot/DuckHunt/docs/SYSTEMD_SERVICE.md
Wants=network-online.target
After=network-online.target
ConditionPathIsDirectory=/home/mediabot/DuckHunt
ConditionPathExists=/etc/pyduckhunt/%i.env
ConditionPathIsSymbolicLink=!/etc/pyduckhunt/%i.env
ConditionPathIsDirectory=/home/mediabot/pyduckhunt-pilot/state
ConditionPathIsDirectory=/home/backupwws/pyduckhunt/pilot
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=mediabot
Group=mediabot
WorkingDirectory=/home/mediabot/DuckHunt
Environment=PYTHONPATH=/home/mediabot/DuckHunt/src
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/pyduckhunt/%i.env
EnvironmentFile=-/etc/pyduckhunt/%i.secret.env
ExecStartPre=/home/mediabot/DuckHunt/.venv/bin/python -B -m pyduckhunt pilot-check $PYDUCKHUNT_TARGET_ARGS
ExecStart=/home/mediabot/DuckHunt/.venv/bin/python -B -m pyduckhunt service-run $PYDUCKHUNT_TARGET_ARGS --confirm-live ${PYDUCKHUNT_CONFIRM_LIVE}
KillSignal=SIGTERM
TimeoutStopSec=15s
Restart=on-failure
RestartSec=30s
UMask=0027
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=read-only
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProtectSystem=strict
ProcSubset=pid
RemoveIPC=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/home/mediabot/pyduckhunt-pilot/state
ReadWritePaths=/home/backupwws/pyduckhunt/pilot
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pyduckhunt-%i

[Install]
WantedBy=multi-user.target
